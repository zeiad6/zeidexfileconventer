{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeidex Convert",
  "version": "0.3.5",
  "identifier": "com.zeidexsoft.convert",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "home",
        "title": "Zeidex Convert",
        "url": "index.html",
        "width": 820,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "transparent": true,
        "decorations": false,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      },
      {
        "label": "wheel",
        "title": "Zeidex wheel",
        "url": "wheel.html",
        "width": 380,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "shelf",
        "title": "Zeidex orb",
        "url": "shelf.html",
        "width": 88,
        "height": 88,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "jobs",
        "title": "Zeidex — jobs",
        "url": "jobs.html",
        "width": 460,
        "height": 470,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "editor",
        "title": "Zeidex — editor",
        "url": "editor.html",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Zeidexsoft",
    "copyright": "© 2026 Zeidexsoft",
    "homepage": "https://zeidexsoft.com",
    "category": "Utility",
    "shortDescription": "Local file converter",
    "longDescription": "Convert and process images, video, audio, PDFs, office documents, ebooks and archives locally. Drag a file, tap Shift, drop it on a format.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "engines/": "engines/",
      "assets/legal/": "legal/",
      "assets/screens/": "screens/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "assets/installer/header.bmp",
        "sidebarImage": "assets/installer/sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "assets/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libvips-tools",
          "ghostscript",
          "qpdf"
        ]
      },
      "rpm": {
        "depends": [
          "vips-tools",
          "ghostscript",
          "qpdf"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "licenseFile": "assets/legal/LICENSE.txt"
  }
}
