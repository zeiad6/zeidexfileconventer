{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeidex Convert",
  "version": "0.2.0",
  "identifier": "com.zeidexsoft.convert",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "home",
        "title": "Zeidex Convert",
        "url": "index.html",
        "width": 820,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "center": true,
        "transparent": true,
        "decorations": false,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      },
      {
        "label": "wheel",
        "title": "Zeidex wheel",
        "url": "wheel.html",
        "width": 480,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "shelf",
        "title": "Zeidex orb",
        "url": "shelf.html",
        "width": 88,
        "height": 88,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "jobs",
        "title": "Zeidex — jobs",
        "url": "jobs.html",
        "width": 460,
        "height": 470,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "editor",
        "title": "Zeidex — editor",
        "url": "editor.html",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Zeidexsoft",
    "copyright": "© 2026 Zeidexsoft",
    "homepage": "https://zeidexsoft.com",
    "category": "Utility",
    "shortDescription": "Local file converter",
    "longDescription": "Convert and process images, video, audio, PDFs, office documents, ebooks and archives locally. Drag a file, tap Shift, drop it on a format.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "engines/": "engines/"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libvips-tools",
          "ghostscript",
          "qpdf"
        ]
      },
      "rpm": {
        "depends": [
          "vips-tools",
          "ghostscript",
          "qpdf"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
