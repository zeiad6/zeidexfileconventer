{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for all Zeidex windows. File work happens in Rust commands, so no fs/shell plugins are exposed.",
  "windows": [
    "home",
    "wheel",
    "shelf",
    "jobs",
    "editor"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "drag:default"
  ]
}
