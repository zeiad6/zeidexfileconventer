{
  "name": "zeidex-ui",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "description": "Zeidex Convert desktop UI: React 19, TypeScript, Tailwind CSS v4, Framer Motion",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "bundle:linux": "tauri build --bundles deb,rpm,appimage",
    "bundle:macos": "tauri build --bundles app,dmg",
    "bundle:windows": "tauri build --bundles msi,nsis"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.10.1",
    "@tauri-apps/cli": "^2.12.4"
  },
  "license": "MIT",
  "author": {
    "name": "Zeidexsoft",
    "url": "https://zeidexsoft.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeiad6/zeidexfileconventer.git"
  },
  "homepage": "https://zeidexsoft.com"
}
